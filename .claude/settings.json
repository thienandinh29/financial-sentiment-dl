{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(python -m pytest*)",
      "Bash(python -m train*)",
      "Bash(python -m evaluate*)",
      "Bash(python scripts/*)",
      "PowerShell(git status*)",
